# Production backend/.env for aiprice.app — fill in the blanks on the server.
# Never commit the filled-in file.

APP_NAME="AIPrice.app"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # php artisan key:generate --show (keep the existing one if already set!)
APP_URL=https://aiprice.app
FRONTEND_URL=https://aiprice.app

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
# Hostinger shared hosting has no supervisor: drain the queue from the cron.
QUEUE_WORKER_VIA_SCHEDULER=true

# Hostinger's CDN (hcdn) sits in front of the site; without this every
# visitor appears to come from the CDN's IP and shares one rate limit.
TRUSTED_PROXIES=*

# Real mail is required: sign-up verification and password resets are emailed.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@aiprice.app
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@aiprice.app"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Leave empty until Stripe is set up — the pricing page then shows "Contact us".
PAYMENT_GATEWAY=stripe
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Cron (hPanel → Advanced → Cron Jobs), every minute:
#   cd ~/domains/aiprice.app/public_html/backend && php artisan schedule:run >> /dev/null 2>&1
